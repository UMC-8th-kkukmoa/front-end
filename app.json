{
  "expo": {
    "name": "kkukmoa",
    "slug": "kkukmoa",
    "version": "0.0.1",
    "scheme": "kkukmoa",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "com.kkukmoa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "kkukmoa",
            "host": "oauth"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "kakao265b5816cef1409cf3f8a345bc136fbe"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "kkukmoa",
            "host": "payments"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-build-properties",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF8246",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
